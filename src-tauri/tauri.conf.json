{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiosky",
  "version": "0.2.0",
  "identifier": "com.kiosky.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kiosky",
        "width": 1000,
        "height": 690,
        "minWidth": 780,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "transparent": false,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=1 --disable-gpu"
      },
      {
        "label": "palette",
        "title": "Palette",
        "url": "index.html#palette",
        "width": 660,
        "height": 430,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=1 --disable-gpu"
      },
      {
        "label": "picker",
        "title": "Pipette",
        "url": "index.html#picker",
        "width": 168,
        "height": 216,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=1 --disable-gpu"
      },
      {
        "label": "widget",
        "title": "Barre flottante",
        "url": "index.html#widget",
        "width": 320,
        "height": 40,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=1 --disable-gpu"
      },
      {
        "label": "tip",
        "title": "Infobulle",
        "url": "index.html#tip",
        "width": 240,
        "height": 80,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=1 --disable-gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}